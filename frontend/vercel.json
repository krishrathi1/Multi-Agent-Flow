{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build:no-prerender",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://architectural-asp-cashiers-dividend.trycloudflare.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://architectural-asp-cashiers-dividend.trycloudflare.com/socket.io/:path*"
    },
    {
      "source": "/preview/:path*",
      "destination": "https://architectural-asp-cashiers-dividend.trycloudflare.com/preview/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
