{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://6e8ce05db42921.app.lhr.life/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://6e8ce05db42921.app.lhr.life/socket.io/:path*"
    },
    {
      "source": "/preview/:path*",
      "destination": "https://6e8ce05db42921.app.lhr.life/preview/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
