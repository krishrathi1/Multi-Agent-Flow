{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://while-twisted-sensitivity-supplier.trycloudflare.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://while-twisted-sensitivity-supplier.trycloudflare.com/socket.io/:path*"
    },
    {
      "source": "/preview/:path*",
      "destination": "https://while-twisted-sensitivity-supplier.trycloudflare.com/preview/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
