DATABASE_URL=
PORT=

# Required in production (min 32 chars each)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=

# AES-256 key for encrypting sensitive data at rest (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
GIT_WEBHOOK_SECRET=

# ── SMTP (Email Verification) ──────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=

# ── Production-chain planner ─────────────────────────────
# Planning order: PLATFORM_ANTHROPIC_API_KEY -> local Claude CLI -> heuristic.
# The CLI path needs no API key; it reuses an authenticated `claude` install.
# CLAUDE_CLI_PLANNER=false            # disable shelling out to the CLI
CLAUDE_CLI_PATH=     # pin the binary location
CLAUDE_CLI_MODEL=    # pin a faster model

# ── Agent execution (production chain runs) ──────────────
# Agents work in a sandboxed workspace per chain, with file tools scoped to it.
# AGENT_WORKSPACE_ROOT=../.nexus-workspaces  # where chain artifacts are written
# AGENT_RUN_MODEL=claude-sonnet-5            # model for agent work (cheaper than Opus)
# AGENT_RUN_TIMEOUT_MS=900000                # per-step cap (15 min)
# AGENT_ALLOW_BASH=false                     # shell access — off by default, escapes the sandbox

# ── Platform LLM API Keys (used when orgs select PLATFORM mode) ──
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_OPENAI_API_KEY=
PLATFORM_GOOGLE_API_KEY=
PLATFORM_MISTRAL_API_KEY=
PLATFORM_GROQ_API_KEY=
PLATFORM_OPENROUTER_API_KEY=

# ── Default Gateway (auto-provisioned for new orgs) ──────
# When set, each new organization automatically gets a gateway — users never see gateway setup.
# The URL should be a WebSocket URL pointing to your OpenClaw gateway instance.
DEFAULT_GATEWAY_URL=
DEFAULT_GATEWAY_TOKEN=
DEFAULT_GATEWAY_WORKSPACE=

# Local LLM runtime configuration
LOCAL_LLM_ENDPOINTS=
LOCAL_LLM_MODEL=
LOCAL_LLM_REQUEST_TIMEOUT_MS=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=

GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
PROMPT_MODELS_JSON=
LLM_PROVIDER_MODEL_MAP_JSON=

# Database seed credentials (required only when running prisma seed)
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=change-me-before-seeding
# OpenCode
OPENCODE_MODEL=
OPENCODE_SMALL_MODEL=
OPENCODE_TIMEOUT_MS=120000
OPENCODE_INSTALL_TIMEOUT_MS=180000
OPENCODE_BIN=
OPENCODE_WORKDIR=
OPENCODE_INSTALL_DISABLED=false
